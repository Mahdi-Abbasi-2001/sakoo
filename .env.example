# Any OpenAI-compatible endpoint: OpenAI for now, BoxAPI when its credits arrive (only these three lines change).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Liara API token (https://console.liara.ir/API)
LIARA_API_TOKEN=
# Needed if your apps live in a team (run `liara-agent whoami` to find the id)
LIARA_TEAM_ID=
